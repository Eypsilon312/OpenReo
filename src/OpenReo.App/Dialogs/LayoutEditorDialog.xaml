<Window x:Class="OpenReo.App.Dialogs.LayoutEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenReo.App.Infrastructure"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="{l:T 'Eigene Layouts'}" Width="860" Height="560" MinWidth="700" MinHeight="460">
    <Grid Margin="20,16,20,18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Saved custom layouts -->
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="{l:T 'EIGENE LAYOUTS'}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="{l:T 'Neu'}" Click="OnNewClick" Margin="0,0,8,0" />
                <Button x:Name="DeleteButton" Content="{l:T 'Löschen'}" Click="OnDeleteClick" />
            </StackPanel>
            <Border Background="{StaticResource BgBrush}" CornerRadius="4">
                <ListBox x:Name="LayoutList" SelectionChanged="OnLayoutSelected" DisplayMemberPath="Name" Padding="0,4" />
            </Border>
        </DockPanel>

        <!-- Editor -->
        <DockPanel Grid.Column="2">
            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Content="{l:T 'Name'}" />
                    <TextBox x:Name="NameBox" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Content="{l:T 'Zeilen'}" />
                    <ComboBox x:Name="RowsBox" SelectionChanged="OnGridSizeChanged" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <Label Content="{l:T 'Spalten'}" />
                    <ComboBox x:Name="ColsBox" SelectionChanged="OnGridSizeChanged" />
                </StackPanel>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource DimText}" FontSize="11.5" Margin="0,10,0,8" TextWrapping="Wrap"
                       Text="{l:T 'Mit der Maus mehrere Zellen markieren und „Zusammenführen“ wählen, um eine große Kachel zu erstellen. Die Nummern geben die Reihenfolge der Kacheln an.'}" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{l:T 'Zusammenführen'}" Click="OnMergeClick" Margin="0,0,8,0" />
                <Button Content="{l:T 'Teilen'}" Click="OnSplitClick" Margin="0,0,8,0" />
                <Button Content="{l:T 'Zurücksetzen'}" Click="OnResetClick" />
            </StackPanel>
            <Border Background="Black" CornerRadius="4" Padding="4">
                <Grid x:Name="PreviewHost" Background="Transparent" MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove" MouseLeftButtonUp="OnPreviewMouseUp">
                    <Grid x:Name="PreviewGrid" IsHitTestVisible="False" />
                    <Grid x:Name="SelectionGrid" IsHitTestVisible="False" />
                </Grid>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="InfoText" DockPanel.Dock="Left" Style="{StaticResource DimText}" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T 'Speichern &amp; anwenden'}" Click="OnSaveApplyClick" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:T 'Speichern'}" Click="OnSaveClick" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:T 'Schließen'}" IsCancel="True" MinWidth="90" />
        </DockPanel>
    </Grid>
</Window>
