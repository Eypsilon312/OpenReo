<Window x:Class="OpenReo.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenReo.App.Infrastructure"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="{l:T 'Einstellungen'}" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20,6,20,18">
        <TextBlock Text="SPRACHE / LANGUAGE" Style="{StaticResource SectionHeader}" />
        <ComboBox x:Name="LanguageBox" Width="300" HorizontalAlignment="Left">
            <ComboBoxItem Content="{l:T 'Automatisch (Windows-Sprache)'}" Tag="auto" />
            <ComboBoxItem Content="Deutsch" Tag="de" />
            <ComboBoxItem Content="English" Tag="en" />
        </ComboBox>
        <TextBlock Text="{l:T 'Die Sprache wird nach einem Neustart von OpenReo übernommen.'}" Style="{StaticResource DimText}" FontSize="11.5" Margin="0,6,0,0" />

        <TextBlock Text="{l:T 'VIDEO'}" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{l:T 'Hardware-Decodierung (GPU)'}" />
                <ComboBox x:Name="HwBox">
                    <ComboBoxItem Content="{l:T 'Automatisch (empfohlen)'}" />
                    <ComboBoxItem Content="{l:T 'D3D11VA'}" />
                    <ComboBoxItem Content="{l:T 'DXVA2'}" />
                    <ComboBoxItem Content="{l:T 'CUDA / NVDEC (NVIDIA)'}" />
                    <ComboBoxItem Content="{l:T 'Aus (nur CPU)'}" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{l:T 'RTSP-Transport'}" />
                <ComboBox x:Name="TransportBox">
                    <ComboBoxItem Content="{l:T 'TCP (empfohlen)'}" />
                    <ComboBoxItem Content="{l:T 'UDP'}" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="HwInfoText" Style="{StaticResource DimText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
        <CheckBox x:Name="LowLatencyBox" Content="{l:T 'Niedrige Latenz (minimale Pufferung)'}" Margin="0,12,0,0" />

        <TextBlock Text="{l:T 'VERBINDUNG'}" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{l:T 'Timeout (s)'}" />
                <TextBox x:Name="TimeoutBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{l:T 'Max. Wiederholintervall (s)'}" />
                <TextBox x:Name="ReconnectBox" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="{l:T 'Stream offen halten (s)'}" ToolTip="{l:T 'Wie lange ein nicht mehr sichtbarer Stream verbunden bleibt (verhindert Neuverbindungen beim Layoutwechsel).'}" />
                <TextBox x:Name="ReleaseBox" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{l:T 'ANZEIGE'}" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <CheckBox x:Name="OverlayBox" Content="{l:T 'Kameraname und Status in den Kacheln anzeigen'}" />
        <CheckBox x:Name="InfoBox" Content="{l:T 'Stream-Informationen anzeigen (Auflösung, fps, Decoder)'}" Margin="0,8,0,0" />

        <TextBlock Text="{l:T 'START'}" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <CheckBox x:Name="RestoreQualityBox" Content="{l:T 'Qualität je Kamera wiederherstellen (sonst starten alle Kameras mit Mid)'}" />
        <CheckBox x:Name="FullscreenBox" Content="{l:T 'Im Vollbild starten'}" Margin="0,8,0,0" />

        <TextBlock Text="{l:T 'KAMERAS'}" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <CheckBox x:Name="RememberCredentialsBox" Content="{l:T 'Zugangsdaten für weitere Kameras merken (verschlüsselt gespeichert)'}" />
        <TextBlock x:Name="RememberedText" Style="{StaticResource DimText}" FontSize="11.5" Margin="24,4,0,0" />

        <TextBlock Text="{l:T 'INFO'}" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <TextBlock x:Name="InfoText" Style="{StaticResource DimText}" FontSize="11.5" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="{l:T 'Datenordner öffnen'}" Click="OnOpenDataFolder" Margin="0,0,8,0" />
            <Button Content="{l:T 'Protokolle öffnen'}" Click="OnOpenLogFolder" />
        </StackPanel>

        <DockPanel Margin="0,22,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T 'Übernehmen'}" MinWidth="100" IsDefault="True" Click="OnOkClick" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:T 'Abbrechen'}" MinWidth="90" IsCancel="True" />
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
