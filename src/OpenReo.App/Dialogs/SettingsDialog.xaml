<Window x:Class="OpenReo.App.Dialogs.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Einstellungen" Width="560" SizeToContent="Height" ResizeMode="NoResize">
    <StackPanel Margin="20,6,20,18">
        <TextBlock Text="VIDEO" Style="{StaticResource SectionHeader}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="Hardware-Decodierung (GPU)" />
                <ComboBox x:Name="HwBox">
                    <ComboBoxItem Content="Automatisch (empfohlen)" />
                    <ComboBoxItem Content="D3D11VA" />
                    <ComboBoxItem Content="DXVA2" />
                    <ComboBoxItem Content="CUDA / NVDEC (NVIDIA)" />
                    <ComboBoxItem Content="Aus (nur CPU)" />
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="RTSP-Transport" />
                <ComboBox x:Name="TransportBox">
                    <ComboBoxItem Content="TCP (empfohlen)" />
                    <ComboBoxItem Content="UDP" />
                </ComboBox>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="HwInfoText" Style="{StaticResource DimText}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap" />
        <CheckBox x:Name="LowLatencyBox" Content="Niedrige Latenz (minimale Pufferung)" Margin="0,12,0,0" />

        <TextBlock Text="VERBINDUNG" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="Timeout (s)" />
                <TextBox x:Name="TimeoutBox" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="Max. Wiederholintervall (s)" />
                <TextBox x:Name="ReconnectBox" />
            </StackPanel>
            <StackPanel Grid.Column="4">
                <Label Content="Stream offen halten (s)" ToolTip="Wie lange ein nicht mehr sichtbarer Stream verbunden bleibt (verhindert Neuverbindungen beim Layoutwechsel)." />
                <TextBox x:Name="ReleaseBox" />
            </StackPanel>
        </Grid>

        <TextBlock Text="ANZEIGE" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <CheckBox x:Name="OverlayBox" Content="Kameraname und Status in den Kacheln anzeigen" />
        <CheckBox x:Name="InfoBox" Content="Stream-Informationen anzeigen (Auflösung, fps, Decoder)" Margin="0,8,0,0" />

        <TextBlock Text="START" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <CheckBox x:Name="RestoreQualityBox" Content="Qualität je Kamera wiederherstellen (sonst starten alle Kameras mit Mid)" />
        <CheckBox x:Name="FullscreenBox" Content="Im Vollbild starten" Margin="0,8,0,0" />

        <TextBlock Text="KAMERAS" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <CheckBox x:Name="RememberCredentialsBox" Content="Zugangsdaten für weitere Kameras merken (verschlüsselt gespeichert)" />
        <TextBlock x:Name="RememberedText" Style="{StaticResource DimText}" FontSize="11.5" Margin="24,4,0,0" />

        <TextBlock Text="INFO" Style="{StaticResource SectionHeader}" Margin="0,20,0,6" />
        <TextBlock x:Name="InfoText" Style="{StaticResource DimText}" FontSize="11.5" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Datenordner öffnen" Click="OnOpenDataFolder" Margin="0,0,8,0" />
            <Button Content="Protokolle öffnen" Click="OnOpenLogFolder" />
        </StackPanel>

        <DockPanel Margin="0,22,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Übernehmen" MinWidth="100" IsDefault="True" Click="OnOkClick" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Abbrechen" MinWidth="90" IsCancel="True" />
            <TextBlock x:Name="ErrorText" DockPanel.Dock="Left" Foreground="{StaticResource ErrorBrush}" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</Window>
