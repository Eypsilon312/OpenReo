<Window x:Class="OpenReo.App.Dialogs.RecordingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenReo.App.Infrastructure"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        Title="{l:T 'Aufnahmen (NAS / Netzlaufwerk)'}" Width="720" Height="560" MinWidth="560" MinHeight="400">
    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap"
                   Text="{l:T 'Ordner wählen, in dem die Kameras ihre Aufnahmen ablegen (z. B. per FTP auf ein NAS). Jeder Unterordner wird einer Kamera zugeordnet; danach steht pro Kamera die Wiedergabe mit Zeitleiste zur Verfügung.'}" />

        <DockPanel Grid.Row="1" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="{l:T 'Ordner einlesen'}" Click="OnScanClick" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:T 'Durchsuchen …'}" Click="OnBrowseClick" Margin="8,0,0,0" />
            <TextBox x:Name="RootBox" ToolTip="\\truenas\kameras" />
        </DockPanel>

        <Grid Grid.Row="2" Margin="12,16,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{l:T 'ORDNER'}" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="1" Text="{l:T 'KAMERA'}" Style="{StaticResource SectionHeader}" Margin="0" />
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BgBrush}" CornerRadius="4">
            <Grid>
                <ListBox x:Name="FolderList" Padding="0,4" />
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DimText}"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="30" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="StatusText" DockPanel.Dock="Left" Style="{StaticResource DimText}" VerticalAlignment="Center" MaxWidth="400" TextTrimming="CharacterEllipsis" />
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{l:T 'Übernehmen'}" MinWidth="100" IsDefault="True" Click="OnOkClick" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:T 'Abbrechen'}" MinWidth="90" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
