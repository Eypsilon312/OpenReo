<Window x:Class="OpenReo.App.Dialogs.DiscoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenReo.App.Infrastructure"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="{l:T 'Kameras im Netzwerk suchen (ONVIF)'}" Width="820" Height="560" MinWidth="640" MinHeight="400">
    <Grid Margin="20,14,20,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="SearchButton" Style="{StaticResource AccentButton}" Click="OnSearchClick" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                    <TextBlock Text="{l:T 'Erneut suchen'}" />
                </StackPanel>
            </Button>
            <TextBlock TextWrapping="Wrap" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="{l:T 'Gefundene Geräte auswählen, Zugangsdaten eingeben und hinzufügen. Doppelklick öffnet die Detaileinstellungen. ONVIF muss in der Kamera aktiviert sein (Reolink: Netzwerk → Erweitert → Server-Einstellungen).'}" />
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <Label Content="{l:T 'Benutzername (für die ausgewählten Kameras)'}" />
                <TextBox x:Name="UserBox" Text="admin" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <Label Content="{l:T 'Passwort'}" />
                <PasswordBox x:Name="PasswordBox" />
            </StackPanel>
        </Grid>

        <!-- header -->
        <Grid Grid.Row="2" Margin="12,16,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{l:T 'IP-ADRESSE'}" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="2" Text="{l:T 'NAME'}" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="3" Text="{l:T 'MODELL'}" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="4" Text="{l:T 'PORT'}" Style="{StaticResource SectionHeader}" Margin="0" />
            <TextBlock Grid.Column="5" Text="{l:T 'STATUS'}" Style="{StaticResource SectionHeader}" Margin="0" />
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource BgBrush}" CornerRadius="4">
            <Grid>
                <ListBox x:Name="DeviceList" MouseDoubleClick="OnDeviceDoubleClick" Padding="0,4">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="170" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding CanAdd}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Address}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{Binding Hardware}" VerticalAlignment="Center" Style="{StaticResource DimText}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="4" Text="{Binding Port}" VerticalAlignment="Center" Style="{StaticResource DimText}" />
                                <TextBlock Grid.Column="5" Text="{Binding Status}" Foreground="{Binding StatusBrush}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource DimText}" TextAlignment="Center" TextWrapping="Wrap" Margin="30" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,16,0,0" LastChildFill="False">
            <TextBlock x:Name="BusyText" DockPanel.Dock="Left" Style="{StaticResource DimText}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
            <Button DockPanel.Dock="Right" x:Name="AddButton" Style="{StaticResource AccentButton}" Content="{l:T 'Ausgewählte hinzufügen'}" Click="OnAddClick" Margin="8,0,0,0" />
            <Button DockPanel.Dock="Right" Content="{l:T 'Schließen'}" IsCancel="True" MinWidth="90" />
        </DockPanel>
    </Grid>
</Window>
