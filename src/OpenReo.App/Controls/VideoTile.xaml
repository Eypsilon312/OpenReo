<UserControl x:Class="OpenReo.App.Controls.VideoTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenReo.App.Infrastructure"
             Focusable="True" FocusVisualStyle="{x:Null}">
    <Border x:Name="Root" Background="Black" BorderThickness="1" BorderBrush="#FF0B0C0F" ClipToBounds="True" AllowDrop="True">
        <Grid>
            <!-- Video with digital zoom / pan -->
            <Grid x:Name="ZoomHost" RenderTransformOrigin="0,0">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="ZoomScale" />
                        <TranslateTransform x:Name="ZoomPan" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="Linear" SnapsToDevicePixels="False" />
            </Grid>

            <!-- Empty tile -->
            <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="22" Foreground="#FF3A4150" />
                <TextBlock x:Name="EmptyText" Text="{l:T 'Kamera hierher ziehen'}" Foreground="#FF4A5263" FontSize="12" Margin="0,6,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Connection state -->
            <Border x:Name="StatusPanel" Background="#B0101216" CornerRadius="6" Padding="14,9" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="Collapsed" IsHitTestVisible="False" Margin="10">
                <StackPanel>
                    <TextBlock x:Name="StatusTitle" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" />
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource DimText}" TextWrapping="Wrap" MaxWidth="340" FontSize="11.5"
                               HorizontalAlignment="Center" TextAlignment="Center" Margin="0,3,0,0" />
                </StackPanel>
            </Border>

            <!-- Top bar: status, name, zoom, quality -->
            <Grid x:Name="TopBar" VerticalAlignment="Top">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#A0000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="7,5,6,10">
                    <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource IdleBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="NameText" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,5,7,10" VerticalAlignment="Top">
                    <Border x:Name="AudioButton" CornerRadius="3" Padding="4,1" Margin="0,0,6,0" Background="#80000000" Cursor="Hand" VerticalAlignment="Center">
                        <TextBlock x:Name="AudioIcon" Text="&#xE74F;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="#B0FFFFFF" />
                    </Border>
                    <TextBlock x:Name="ZoomText" FontSize="11" Foreground="#DDFFFFFF" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    <Border x:Name="QualityBadge" CornerRadius="3" Padding="5,1" Background="#B02F8CFF">
                        <TextBlock x:Name="QualityText" FontSize="10.5" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Stream information -->
            <TextBlock x:Name="InfoText" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="7,0,6,5" FontSize="10.5"
                       Foreground="#D0FFFFFF" TextTrimming="CharacterEllipsis">
                <TextBlock.Effect>
                    <DropShadowEffect ShadowDepth="0" BlurRadius="3" Opacity="0.9" RenderingBias="Performance" />
                </TextBlock.Effect>
            </TextBlock>

            <Border x:Name="SelectionBorder" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Visibility="Collapsed" IsHitTestVisible="False" />
            <Border x:Name="DropHighlight" BorderBrush="{StaticResource AccentBrush}" BorderThickness="3" Background="#202F8CFF" Visibility="Collapsed" IsHitTestVisible="False" />
        </Grid>
    </Border>
</UserControl>
