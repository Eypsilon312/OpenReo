<Window x:Class="OpenReo.App.CameraSettings.CameraSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenReo.App.Infrastructure"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Title="{l:T 'Kameraeinstellungen'}" Width="980" Height="720" MinWidth="760" MinHeight="480">
    <Grid Background="{StaticResource PanelBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Navigation -->
        <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,14,12,10">
                    <TextBlock x:Name="CameraNameText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="CameraInfoText" Style="{StaticResource DimText}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
                <ListBox x:Name="PageList" SelectionChanged="OnPageSelected" />
            </DockPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer x:Name="ContentScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="24,10,24,20">
            <StackPanel x:Name="ContentPanel" />
        </ScrollViewer>
        <StackPanel x:Name="LoadingPanel" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="LoadingText" Text="{l:T 'Verbinde mit der Kamera …'}" HorizontalAlignment="Center" FontSize="14" />
            <TextBlock x:Name="LoadingDetail" Style="{StaticResource DimText}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="460" TextAlignment="Center" />
        </StackPanel>

        <!-- Bottom bar -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="ApplyButton" Style="{StaticResource AccentButton}" Content="{l:T 'Übernehmen'}" MinWidth="110" Margin="8,0,0,0" Click="OnApplyClick" IsEnabled="False" />
                <Button DockPanel.Dock="Right" x:Name="RevertButton" Content="{l:T 'Verwerfen'}" Margin="8,0,0,0" Click="OnRevertClick" IsEnabled="False" />
                <Button DockPanel.Dock="Right" x:Name="ReloadButton" Content="{l:T 'Neu laden'}" Margin="8,0,0,0" Click="OnReloadClick" IsEnabled="False" />
                <Button DockPanel.Dock="Right" Content="{l:T 'Schließen'}" IsCancel="True" MinWidth="90" Click="OnCloseClick" />
                <TextBlock x:Name="StatusText" Style="{StaticResource DimText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
