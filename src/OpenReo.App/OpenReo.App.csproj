<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <AssemblyName>OpenReo</AssemblyName>
    <RootNamespace>OpenReo.App</RootNamespace>
    <Product>OpenReo</Product>
    <Description>Native Windows viewer for Reolink IP cameras</Description>
    <Version>1.4.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\openreo.ico</ApplicationIcon>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenReo.Core\OpenReo.Core.csproj" />
    <ProjectReference Include="..\OpenReo.Video\OpenReo.Video.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\openreo.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

</Project>
