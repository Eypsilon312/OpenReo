<Window x:Class="OpenReo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:OpenReo.App.Infrastructure"
        xmlns:controls="clr-namespace:OpenReo.App.Controls"
        Title="OpenReo" Width="1440" Height="860" MinWidth="800" MinHeight="500"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="270" MinWidth="0" MaxWidth="600" />
            <ColumnDefinition x:Name="SplitterColumn" Width="3" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border x:Name="Sidebar" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="14,12,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="OpenReo" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock x:Name="CameraCountText" Style="{StaticResource DimText}" Margin="8,2,0,0" VerticalAlignment="Center" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolButton}" ToolTip="{l:T 'Kameras im Netzwerk suchen (ONVIF)'}" Click="OnDiscoverClick">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" />
                        </Button>
                        <Button Style="{StaticResource ToolButton}" ToolTip="{l:T 'Kamera manuell hinzufügen'}" Click="OnAddCameraClick">
                            <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}" />

                <!-- empty state -->
                <StackPanel x:Name="NoCamerasPanel" DockPanel.Dock="Top" Margin="18,24,18,0" Visibility="Collapsed">
                    <TextBlock Text="{l:T 'Noch keine Kameras'}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource DimText}" TextWrapping="Wrap" Margin="0,6,0,14"
                               Text="{l:T 'Suchen Sie Reolink-Kameras automatisch per ONVIF oder fügen Sie eine Kamera über ihre IP-Adresse hinzu.'}" />
                    <Button Style="{StaticResource AccentButton}" Content="{l:T 'Kameras suchen'}" Click="OnDiscoverClick" Margin="0,0,0,8" />
                    <Button Content="{l:T 'Manuell hinzufügen'}" Click="OnAddCameraClick" />
                </StackPanel>

                <ListBox x:Name="CameraList" Margin="0,6,0,6" AllowDrop="True" SelectionMode="Single"
                         PreviewMouseLeftButtonDown="OnCameraListMouseDown" PreviewMouseMove="OnCameraListMouseMove"
                         MouseDoubleClick="OnCameraListDoubleClick" Drop="OnCameraListDrop" DragOver="OnCameraListDragOver"
                         ContextMenuOpening="OnCameraListContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu />
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding StatusText}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="28" Height="28" Margin="0,0,10,0">
                                    <Border CornerRadius="5" Background="{StaticResource Panel2Brush}" />
                                    <TextBlock Text="&#xE714;" Style="{StaticResource Icon}" FontSize="14" Foreground="{StaticResource TextDimBrush}" />
                                    <Ellipse Width="9" Height="9" Fill="{Binding StatusBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="1.5"
                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,-2" />
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource DimText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <TextBlock Text="&#xE7B3;" Style="{StaticResource Icon}" FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"
                                               ToolTip="{l:T 'In der aktuellen Ansicht'}">
                                        <TextBlock.Visibility>
                                            <Binding Path="IsInView" Converter="{StaticResource BoolToVis}" />
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                    <Border CornerRadius="3" Padding="5,1" Background="{StaticResource Panel2Brush}">
                                        <TextBlock Text="{Binding QualityText}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="Splitter" Grid.Column="1" Width="3" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

        <!-- ================= Main area ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ToolbarRow" Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="StatusRow" Height="26" />
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <Border x:Name="Toolbar" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="6,0,8,0" LastChildFill="False">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" ToolTip="{l:T 'Seitenleiste ein-/ausblenden'}" Click="OnToggleSidebarClick">
                        <TextBlock Text="&#xE700;" Style="{StaticResource Icon}" />
                    </Button>
                    <Border DockPanel.Dock="Left" Width="1" Margin="6,10" Background="{StaticResource BorderBrush}" />
                    <StackPanel x:Name="LayoutButtons" DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" />
                    <Button x:Name="MoreLayoutsButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" ToolTip="{l:T 'Weitere und eigene Layouts'}" Click="OnMoreLayoutsClick" Margin="2,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T 'Layouts'}" Margin="0,0,4,0" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ViewsButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" ToolTip="{l:T 'Gespeicherte Ansichten'}" Click="OnViewsClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE728;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T 'Ansichten'}" Margin="0,0,4,0" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PlaybackButton" DockPanel.Dock="Left" Style="{StaticResource ToolButton}" ToolTip="{l:T 'Aufnahmen wiedergeben'}" Click="OnPlaybackMenuClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE81C;" Style="{StaticResource Icon}" Margin="0,0,6,0" />
                            <TextBlock Text="{l:T 'Wiedergabe'}" Margin="0,0,4,0" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="9" />
                        </StackPanel>
                    </Button>

                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="{l:T 'Einstellungen'}" Click="OnSettingsClick">
                        <TextBlock Text="&#xE713;" Style="{StaticResource Icon}" />
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" ToolTip="{l:T 'Vollbild (F11)'}" Click="OnFullscreenClick">
                        <TextBlock Text="&#xE740;" Style="{StaticResource Icon}" />
                    </Button>
                    <Border DockPanel.Dock="Right" Width="1" Margin="8,10" Background="{StaticResource BorderBrush}" />
                    <Border DockPanel.Dock="Right" Background="{StaticResource BgBrush}" CornerRadius="4" Padding="2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton x:Name="GlobalClear" Style="{StaticResource SegmentToggle}" Content="Clear" Click="OnGlobalQualityClick" Tag="Clear"
                                          ToolTip="{l:T 'Alle Kameras: Hauptstream (höchste Auflösung)'}" />
                            <ToggleButton x:Name="GlobalMid" Style="{StaticResource SegmentToggle}" Content="Mid" Click="OnGlobalQualityClick" Tag="Mid"
                                          ToolTip="{l:T 'Alle Kameras: mittlere Auflösung'}" />
                            <ToggleButton x:Name="GlobalLow" Style="{StaticResource SegmentToggle}" Content="Low" Click="OnGlobalQualityClick" Tag="Low"
                                          ToolTip="{l:T 'Alle Kameras: Substream (niedrigste Auflösung)'}" />
                        </StackPanel>
                    </Border>
                    <TextBlock DockPanel.Dock="Right" Text="{l:T 'Qualität (alle):'}" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border DockPanel.Dock="Right" Width="1" Margin="10,10" Background="{StaticResource BorderBrush}" />
                    <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="90" Minimum="0" Maximum="100" VerticalAlignment="Center"
                            ValueChanged="OnVolumeChanged" ToolTip="{l:T 'Lautstärke'}" IsMoveToPointEnabled="True" />
                    <Button x:Name="MuteButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Click="OnMuteClick" ToolTip="{l:T 'Ton stumm schalten'}">
                        <TextBlock x:Name="MuteIcon" Text="&#xE767;" Style="{StaticResource Icon}" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- Multiview -->
            <controls:MultiViewPanel x:Name="MultiView" Grid.Row="1" />

            <!-- Fullscreen hint -->
            <Border x:Name="FullscreenHint" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Background="#D0101216" CornerRadius="6" Padding="14,8" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="{l:T 'Vollbild – Esc oder F11 zum Beenden'}" />
            </Border>

            <!-- Status bar -->
            <Border x:Name="StatusBar" Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="12,0">
                    <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource DimText}" FontSize="11.5" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLeft" Style="{StaticResource DimText}" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
